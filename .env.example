# Application
HTTP_PORT=8080
JWT_ACCESS_SECRET=replace-with-a-strong-access-secret
JWT_REFRESH_SECRET=replace-with-a-strong-refresh-secret

# Nginx (external port used by Docker Compose)
NGINX_PORT=8080

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=booking_db
POSTGRES_DSN=postgresql://postgres:root@localhost:5432/booking_db?sslmode=disable

# Redis
REDIS_DSN=redis://localhost:6379/0
